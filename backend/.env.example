# Database (PostgreSQL required)
DATABASE_URL=postgresql://user:password@localhost:5432/locallink
# For Railway deployment, set this to your Railway PostgreSQL URL

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URLs
FRONTEND_URL=http://localhost:5173
# For production: https://your-frontend-domain.com

# Redis (optional - caching/rate limiting disabled if not available)
REDIS_HOST=localhost
REDIS_PORT=6379

# Clerk Authentication (optional)
CLERK_SECRET_KEY=your_clerk_secret_key_here

